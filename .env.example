# Chạy `npm run setup` để tạo .env với mật khẩu ngẫu nhiên.
# Chỉ máy chủ đọc tệp này. KHÔNG đưa .env lên GitHub hoặc gửi cho học sinh.
TEACHER_PASSWORD=thay-bang-mat-khau-rieng-it-nhat-12-ky-tu
PORT=3001
DATA_DIR=./data
# sqlite: thử trên máy và giữ dữ liệu cũ. supabase: lưu dùng chung trên mạng.
STORAGE_PROVIDER=sqlite
# Chỉ điền khi STORAGE_PROVIDER=supabase. KHÔNG dùng tiền tố VITE_ cho khóa.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=sky-images
NODE_ENV=development
# Khi triển khai: https://ten-web-cua-ban.onrender.com
# Render tự cung cấp RENDER_EXTERNAL_URL nếu để trống PUBLIC_URL.
PUBLIC_URL=
# Bật 1 khi đứng sau proxy của Render; giữ 0 khi chạy trực tiếp.
TRUST_PROXY=0
# Không cần API key. Có thể thêm email liên hệ trong User-Agent Wikimedia.
COMMONS_USER_AGENT=BauTroiCamXuc/1.0 (educational classroom application)
# Tùy chọn khi thử điện thoại cùng Wi-Fi trong chế độ npm run dev:
# DEV_ORIGINS=http://192.168.1.10:5173
