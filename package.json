  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n SERVER,WEB -c cyan,magenta \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "check:supabase": "node --env-file-if-exists=.env scripts/check-supabase.mjs"
  },
  "dependencies": {
    "@fontsource/noto-emoji": "^5.3.2",
